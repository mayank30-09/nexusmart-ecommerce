# ==============================================================================
# NexusMart E-Commerce Platform - Production & Development Environment Variables
# Copy this file to .env for local development.
# In production (e.g. Render), configure these in your dashboard Environment Secrets.
# WARNING: NEVER commit real credentials, secret keys, or database URLs to Git!
# ==============================================================================

# 1. Flask Core Security & Base URL
FLASK_ENV=production
FLASK_SECRET_KEY=generate_using_python_secrets_token_hex_32
APP_BASE_URL=https://nexusmart-production.onrender.com

# 2. Database Connection
# SQLite (Local development default): leave blank or unset to use local ecommerce.db
# PostgreSQL (Production / Render Managed Postgres):
# Example: postgresql://nexusmart_user:secret_password@dpg-xxxx.render.com:5432/nexusmart_db
DATABASE_URL=

# 3. Razorpay Standard Checkout Gateway (Test Mode / Live Mode)
# Obtain from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
# Configure webhook at: https://dashboard.razorpay.com/#/app/webhooks
# Webhook URL: https://<YOUR_DEPLOYED_URL>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=YourConfiguredWebhookSecretHere

# 4. Google OAuth 2.0 Web Application Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-oauth-client-secret
# Authorized Redirect URI must match:
# https://<YOUR_DEPLOYED_URL>/auth/google/callback
GOOGLE_REDIRECT_URI=https://nexusmart-production.onrender.com/auth/google/callback

# 5. Optional Feature Flags
# Set to 'true' to enable the test simulator on checkout (for testing/development only)
ENABLE_MOCK_PAYMENT=false
